// MysticNameTags - Owned Tags UI (v2 template redesign)
// Controller: MysticNameTagsOwnedTagsUI
//
// Rows are stamped dynamically into #OwnedList as an inline row group with
// three appended children: [0] OwnedTagRowMain.ui (click = equip toggle),
// [1] OwnedTagRowFav.ui, [2] OwnedTagRowEquip.ui.

$C = "../Common.ui";
$M = "MysticCommon.ui";

$C.@PageOverlay {
  LayoutMode: Top;

  SceneBlur #SceneBlur1 {}
  SceneBlur #SceneBlur2 {}

  Group {
    LayoutMode: Middle;
    FlexWeight: 1;

    $M.@Window #OwnedTagsRoot {
      Anchor: (Width: 1180, Height: 780);

      $M.@TitleBanner {}

      // ==================== TOP INFO ====================
      $M.@Card {
        Anchor: (Height: 196, Bottom: 14);

        $M.@Divider {}

        Label #SubtitleLabel {
          Text: "View and equip tags you already own.";
          Anchor: (Height: 18, Bottom: 10);
          Style: (FontSize: 13, TextColor: #cbd5f5, HorizontalAlignment: Center);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 20, Bottom: 10);
          Label #CurrentTagPrefix {
            Text: "Current:";
            Style: $M.@StatLabelStyle;
            Anchor: (Width: 86, Vertical: 0);
          }
          // Set at runtime via .TextSpans so the nameplate keeps all of its colors.
          Label #CurrentNameplateLabel {
            Style: $M.@StatValueStyle;
            FlexWeight: 1;
          }
        }

        $M.@SearchBar {}

        Label #QuickLoadoutLabel {
          Text: "Quick Loadout: empty";
          Anchor: (Height: 18, Bottom: 8);
          Style: (FontSize: 12, TextColor: #96a9be, HorizontalAlignment: Center, VerticalAlignment: Center);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 36);

          $C.@SmallSecondaryTextButton #RandomOwnedButton {
            Text: "RANDOM OWNED";
            FlexWeight: 1;
            Anchor: (Height: 32);
          }

          Group { Anchor: (Width: 8); }

          $C.@SmallSecondaryTextButton #RandomFavoriteButton {
            Text: "RANDOM FAVORITE";
            FlexWeight: 1;
            Anchor: (Height: 32);
          }

          Group { Anchor: (Width: 8); }

          $C.@SmallSecondaryTextButton #SaveQuickLoadoutButton {
            Text: "SAVE QUICK";
            FlexWeight: 1;
            Anchor: (Height: 32);
          }

          Group { Anchor: (Width: 8); }

          $C.@SmallSecondaryTextButton #EquipQuickLoadoutButton {
            Text: "EQUIP QUICK";
            FlexWeight: 1;
            Anchor: (Height: 32);
          }

          Group { Anchor: (Width: 8); }

          $C.@SmallSecondaryTextButton #DeleteQuickLoadoutButton {
            Text: "DELETE QUICK";
            FlexWeight: 1;
            Anchor: (Height: 32);
          }
        }
      }

      // ==================== LIST ====================
      $M.@Card {
        FlexWeight: 1;

        $M.@Divider {}

        $M.@SectionHeader #ListSectionTitle { Text: "YOUR TAGS"; }

        Label #EmptyOwnedLabel {
          Text: "You do not own any tags yet.";
          Style: $M.@EmptyStyle;
          Anchor: (Height: 30, Bottom: 8);
          Visible: false;
        }

        Group #OwnedList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }

        Group { Anchor: (Height: 10); }

        $M.@PagerFooter {}
      }

      Group { Anchor: (Height: 10); }

      $M.@PageFooter {}
    }
  }
}
