// MysticNameTags - Owned tag row: main clickable area (equip/unequip toggle)
// Appended as child [0] of an inline row group inside #OwnedList:
//   bind "#OwnedList[i][0]", set "#OwnedList[i][0] #Name.Text" etc.

$M = "MysticCommon.ui";

Button {
  FlexWeight: 1;
  LayoutMode: Left;
  Padding: (Left: 8, Right: 8);
  Style: (
    Hovered: (Background: #1c2430(0.95)),
    Pressed: (Background: #10151c(0.95))
  );

  Group #Accent {
    Anchor: (Width: 4, Height: 34, Vertical: 0, Right: 10);
    OutlineColor: #3a3a3a;
    OutlineSize: 2;
  }

  Group {
    LayoutMode: Top;
    FlexWeight: 1;
    Anchor: (Height: 34, Vertical: 0);

    // Text is supplied at runtime via .TextSpans - never also set .Text on this label.
    Label #Name {
      Style: $M.@RowNameStyle;
      Anchor: (Height: 18, Bottom: 2);
    }

    // Text is supplied at runtime via .TextSpans - never also set .Text on this label.
    Label #Description {
      Style: $M.@RowDescStyle;
      Anchor: (Height: 14);
    }
  }

  Group #StatePill {
    Anchor: (Width: 72, Height: 20, Vertical: 0, Left: 8);
    Background: (Color: #0d1117(0.9));
    OutlineColor: #58a6ff;
    OutlineSize: 1;
    LayoutMode: Middle;

    Label #State {
      Style: $M.@PillLabelStyle;
    }
  }
}
