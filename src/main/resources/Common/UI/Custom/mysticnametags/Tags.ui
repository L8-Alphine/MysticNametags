// MysticNameTags - Tag Selection UI (v2 template redesign)
// Controller: MysticNameTagsTagsUI
//
// Tag rows are stamped dynamically from TagRow.ui into #TagList
// (cmd.clear + cmd.append, addressed as "#TagList[i] ...").

$C = "../Common.ui";
$M = "MysticCommon.ui";

$C.@PageOverlay {
  LayoutMode: Top;

  SceneBlur #SceneBlur1 {}
  SceneBlur #SceneBlur2 {}

  Group {
    LayoutMode: Middle;
    FlexWeight: 1;

    $M.@Window #MainContent {
      Anchor: (Width: 1380, Height: 950);

      $M.@TitleBanner {}

      Group {
        FlexWeight: 1;
        LayoutMode: Left;

        // ==================== LEFT COLUMN ====================
        Group #LeftMainPanel {
          Anchor: (Width: 470, Right: 28);
          LayoutMode: Top;

          // ---- Player + filters card ----
          $M.@Card {
            Anchor: (Height: 278, Bottom: 18);

            $M.@Divider {}

            $M.@SectionHeader #PlayerSectionTitle { Text: "PLAYER"; }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 20, Bottom: 6);
              Label #PlayerLabel { Text: "Player:"; Style: $M.@StatLabelStyle; Anchor: (Width: 92, Vertical: 0); }
              Label #PlayerNameLabel { Text: "Player"; Style: $M.@StatValueStyle; FlexWeight: 1; }
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 20, Bottom: 6);
              Label #BalancePrefixLabel { Text: "Balance:"; Style: $M.@StatLabelStyle; Anchor: (Width: 92, Vertical: 0); }
              Label #BalanceLabel { Text: "Loading..."; Style: $M.@StatValueStyle; FlexWeight: 1; }
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 20, Bottom: 12);
              Label #CurrentTagPrefixLabel { Text: "Current Tag:"; Style: $M.@StatLabelStyle; Anchor: (Width: 92, Vertical: 0); }
              Label #CurrentNameplateLabel { Text: "(loading...)"; Style: $M.@StatValueStyle; FlexWeight: 1; }
            }

            $M.@Divider {}

            $M.@SectionHeader #FiltersSectionTitle { Text: "FILTERS"; }

            $M.@SearchBar {}

            Group {
              LayoutMode: Left;
              Anchor: (Height: 40, Bottom: 4);

              Label #CategoryPrefixLabel {
                Text: "Category:";
                Style: $M.@StatLabelStyle;
                Anchor: (Width: 76, Vertical: 0);
              }

              Label #CategoryValueLabel {
                Text: "All";
                Style: $M.@StatValueStyle;
                FlexWeight: 1;
                Anchor: (Vertical: 0);
              }

              $C.@SmallSecondaryTextButton #PrevCategoryButton {
                Text: "<";
                Anchor: (Width: 34, Height: 16, Vertical: 0);
              }

              Group { Anchor: (Width: 4); }

              $C.@SmallSecondaryTextButton #NextCategoryButton {
                Text: ">";
                Anchor: (Width: 34, Height: 16, Vertical: 0);
              }
            }
          }

          // ---- Tag list card ----
          $M.@Card {
            FlexWeight: 1;

            $M.@Divider {}

            $M.@SectionHeader #AvailableTagsTitle { Text: "AVAILABLE TAGS"; }

            Label #TagListEmpty {
              Text: "No tags match your filters.";
              Style: $M.@EmptyStyle;
              Anchor: (Height: 30, Bottom: 8);
              Visible: false;
            }

            Group #TagList {
              FlexWeight: 1;
              LayoutMode: TopScrolling;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
            }

            Group { Anchor: (Height: 12); }

            $M.@PagerFooter {}
          }
        }

        // ==================== DETAIL PANEL ====================
        Group #DetailPanel {
          FlexWeight: 1;
          LayoutMode: Top;

          Label #DetailEmpty {
            Style: $M.@EmptyStyle;
            Text: "Select a tag to view details";
            FlexWeight: 1;
            Visible: true;
          }

          Group #DetailContent {
            LayoutMode: Top;
            FlexWeight: 1;
            Visible: false;

            $M.@Card {
              Anchor: (Height: 420, Bottom: 18);
              Padding: (Full: 20);

              $M.@Divider {}

              Group {
                LayoutMode: Left;
                Anchor: (Height: 44, Bottom: 10);

                Group #DetailUnknownItemIcon {
                  Anchor: (Width: 38, Height: 38, Vertical: 0, Right: 12);
                  Background: (TexturePath: "../Common/SearchIcon.png");
                }

                Group {
                  LayoutMode: Top;
                  FlexWeight: 1;
                  Anchor: (Vertical: 0);

                  Label #DetailName {
                    Style: (FontSize: 22, RenderBold: true, RenderUppercase: true, TextColor: #41f1ff);
                    Text: "";
                    Anchor: (Height: 28, Bottom: 2);
                  }

                  Label #DetailLore {
                    Style: (FontSize: 10, TextColor: #6e7681);
                    Text: "";
                    Anchor: (Height: 18);
                  }
                }

                $C.@SmallSecondaryTextButton #DetailHelpButton {
                  Text: "?";
                  Anchor: (Width: 34, Height: 32, Vertical: 0, Left: 8);
                }
              }

              Group {
                Anchor: (Height: 60, Bottom: 16);
                LayoutMode: Top;

                Group {
                  Anchor: (Full: 1);
                  LayoutMode: TopScrolling;
                  ScrollbarStyle: $C.@DefaultScrollbarStyle;

                  Group {
                    LayoutMode: Top;

                    Label #DetailDesc {
                      Style: (FontSize: 12, TextColor: #c9d1d9, Wrap: true);
                      Text: "";
                      FlexWeight: 1;
                    }
                  }
                }
              }

              $M.@Divider {}

              $M.@SectionHeader #DetailSectionTitle { Text: "DETAILS"; Anchor: (Height: 18, Bottom: 10); }

              Group {
                LayoutMode: Left;
                Anchor: (Height: 24, Bottom: 6);
                Label #DetailCategoryPrefix { Text: "Category"; Style: $M.@StatLabelStyle; Anchor: (Width: 90, Vertical: 0); }
                Label #DetailCategory { Text: "None"; Style: $M.@StatValueStyle; FlexWeight: 1; }
              }

              Group {
                LayoutMode: Left;
                Anchor: (Height: 24, Bottom: 6);
                Label #DetailPricePrefix { Text: "Price"; Style: $M.@StatLabelStyle; Anchor: (Width: 90, Vertical: 0); }
                Label #DetailPrice { Text: "Free"; Style: $M.@StatValueStyle; FlexWeight: 1; }
              }

              Group {
                LayoutMode: Left;
                Anchor: (Height: 24, Bottom: 6);
                Label #DetailStatusPrefix { Text: "Status"; Style: $M.@StatLabelStyle; Anchor: (Width: 90, Vertical: 0); }
                Label #DetailStatus { Text: "Available"; Style: $M.@StatValueStyle; FlexWeight: 1; }
              }

              Group {
                LayoutMode: Left;
                Anchor: (Height: 24, Bottom: 10);
                Label #DetailPreviewPrefix { Text: "Preview"; Style: $M.@StatLabelStyle; Anchor: (Width: 90, Vertical: 0); }
                Label #DetailPreview { Text: ""; Style: $M.@StatValueStyle; FlexWeight: 1; }
              }

              $M.@Divider {}

              $M.@SectionHeader #ProgressSectionTitle { Text: "PROGRESS"; }

              $C.@ProgressBar #DetailProgressBar {
                @Anchor = (Bottom: 6, Left: 0, Right: 40);
                Value: 0.0;
              }

              Label #DetailProgressText {
                Text: "0% complete";
                Style: (FontSize: 11, TextColor: $C.@ColorCaptionLight);
                Anchor: (Height: 18);
              }
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 250, Bottom: 18);

              Group #RequirementsPanel {
                FlexWeight: 1;
                Anchor: (Height: 250, Right: 10);
                Background: (TexturePath: "../Common/ContainerFullPatch.png", Border: 23);
                Padding: (Full: 14);
                LayoutMode: Top;
                Visible: false;

                $M.@Divider {}

                $M.@SectionHeader #RequirementsTitle { Text: "REQUIREMENTS"; }

                Group {
                  FlexWeight: 1;
                  LayoutMode: TopScrolling;
                  ScrollbarStyle: $C.@DefaultScrollbarStyle;

                  Group {
                    LayoutMode: Top;

                    Label #RequirementsText {
                      Text: "";
                      Style: $M.@BodyTextStyle;
                      FlexWeight: 1;
                    }
                  }
                }
              }

              Group #HowItWorksPopup {
                FlexWeight: 1;
                Anchor: (Height: 250);
                Background: (TexturePath: "../Common/ContainerFullPatch.png", Border: 23);
                Padding: (Full: 14);
                LayoutMode: Top;
                Visible: false;

                $M.@Divider {}

                Group {
                  LayoutMode: Left;
                  Anchor: (Height: 20, Bottom: 8);

                  Label #HowItWorksTitle {
                    Text: "HOW IT WORKS";
                    Style: $M.@SectionTitleStyle;
                    FlexWeight: 1;
                  }

                  $C.@SmallSecondaryTextButton #HowItWorksCloseButton {
                    Text: "CLOSE";
                    Anchor: (Width: 90, Height: 28, Vertical: 0);
                  }
                }

                Group {
                  FlexWeight: 1;
                  LayoutMode: TopScrolling;
                  ScrollbarStyle: $C.@DefaultScrollbarStyle;

                  Group {
                    LayoutMode: Top;

                    Label #HowItWorksText {
                      Text: "";
                      Style: $M.@BodyTextStyle;
                      FlexWeight: 1;
                    }
                  }
                }
              }
            }

            Group { FlexWeight: 1; }

            Label #CooldownWarning {
              Style: (FontSize: 11, TextColor: #f0b429, HorizontalAlignment: Center, VerticalAlignment: Center);
              Text: "";
              Anchor: (Height: 20, Bottom: 10);
              Visible: false;
            }

            Group {
              LayoutMode: Middle;
              Anchor: (Height: 52, Bottom: 10);

              TextButton #SelectBtn {
                Text: "SELECT TAG";
                Anchor: (Width: 250, Height: 42);
                Style: $M.@PrimaryBtnStyle;
              }
            }
          }
        }
      }

      Group { Anchor: (Height: 10); }

      $M.@PageFooter {}
    }
  }
}
